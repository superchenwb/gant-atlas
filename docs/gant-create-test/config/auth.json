{
  "environments": {
    "dev": {
      "baseUrl": "http://localhost:9092",
      "credentials": {
        "username": "admin",
        "password": "gant001"
      },
      "storageStatePath": "~/.playwright-mcp/auth/ibom-dev-storage-state.json",
      "description": "开发环境"
    }
  },
  "defaultEnvironment": "dev",
  "playwrightMCP": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest",
      "--output-dir",
      "~/.playwright-mcp/output",
      "--storage-state",
      "{{storageStatePath}}"
    ]
  },
  "authFlow": {
    "loginUrl": "/login",
    "loginSelectors": {
      "username": "input[placeholder*='请输入用户名'], input[id='basic_userLoginName']",
      "password": "input[placeholder*='请输入密码'], input[id='basic_password']",
      "submit": "button[type='submit']"
    },
    "successIndicator": ".ant-layout, .ant-pro-layout",
    "storageStateSavePath": "~/.playwright-mcp/auth/"
  },
  "notes": [
    "首次登录不带 --storage-state 参数，手动登录后保存",
    "后续使用 --storage-state 参数自动恢复登录态",
    "Storage state 文件包含敏感信息，注意权限管理",
    "Token 可能过期，定期更新 storage state",
    "不同环境需要分别保存 storage state"
  ]
}